.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f8f9ff 0%, #e8eeff 100%);
  padding: 40rpx 30rpx;
}

.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  margin-bottom: 16rpx;
}

.tip {
  font-size: 26rpx;
  color: #666;
}

.plans-list {
  margin-bottom: 40rpx;
}

.plan-item {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(100, 120, 180, 0.08);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.plan-label {
  font-size: 28rpx;
  color: #4f46e5;
  font-weight: 600;
}

.plan-remove {
  color: #ef4444;
  font-size: 32rpx;
  padding: 8rpx 16rpx;
}

.plan-input {
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  margin-bottom: 20rpx;
  background: #f9fafb;
}

.date-time-row {
  display: flex;
  gap: 16rpx;
}

.date-picker,
.time-picker {
  flex: 1;
  border: 2rpx solid #e5e7eb;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date-text,
.time-text {
  font-size: 28rpx;
  color: #374151;
}

.date-placeholder,
.time-placeholder {
  font-size: 28rpx;
  color: #9ca3af;
}

.add-plan {
  text-align: center;
  padding: 28rpx;
  color: #4f46e5;
  font-size: 30rpx;
  font-weight: 500;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
}

.action-bar {
  padding: 0 10rpx;
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #fff;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.3);
}

.submit-btn[disabled] {
  opacity: 0.5;
}

.existing-plans {
  margin-top: 60rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a2e;
  display: block;
  margin-bottom: 24rpx;
}

.existing-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(100, 120, 180, 0.06);
}

.existing-title {
  font-size: 28rpx;
  color: #374151;
}

.existing-date {
  font-size: 24rpx;
  color: #9ca3af;
}
